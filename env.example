# AlfaComp Admin Panel — Environment Variables Example
# Copy this file to .env and configure your credentials.
# SECURITY NOTICE: Never commit .env or secret tokens to a public repository!

VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
BOT_TOKEN="your_telegram_bot_token"
VITE_BOT_TOKEN="your_telegram_bot_token"
